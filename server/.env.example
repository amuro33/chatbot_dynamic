APP_ENV=local
CLIENT_ORIGIN=http://localhost:3000

# OpenAI compatible internal LLM endpoint.
LLM_BASE_URL=https://internal-llm.example.com/v1
LLM_MODEL=internal-chat-model
LLM_X_DEP_TICKET=
LLM_SEND_SYSTEM_NAME=
LLM_USER_ID=
LLM_USER_TYPE=

# MCP streamable-http server endpoint and tool names.
MCP_SERVER_URL=http://localhost:9000/mcp
MCP_SEARCH_TOOL_NAME=search_sql
MCP_EXECUTE_TOOL_NAME=execute_sql
MCP_QUERY_LOG_TOOL_NAME=get_query_log
MCP_TIMEOUT_SECONDS=60
